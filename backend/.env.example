# Local only: copy to backend/.env. Do not upload .env; use App Service settings.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=claw
MYSQL_USER=claw
MYSQL_PASSWORD=replace-with-local-password
MYSQL_SSL=false
# Optional PEM root-CA bundle: absolute path or relative to backend/, not cwd.
# Empty uses Node's maintained trusted root certificates, with full verification.
MYSQL_SSL_CA=
TRUST_PROXY_HOPS=0
# PORT is deliberately omitted. Local API defaults to 5001; Azure supplies PORT.
# Production App Service settings (replace placeholders, no trailing slash):
# NODE_ENV=production
# APP_ORIGIN=https://<app-name>.azurewebsites.net
# MYSQL_HOST=<mysql-server>.mysql.database.azure.com
# MYSQL_PORT=3306
# MYSQL_DATABASE=claw
# MYSQL_USER=<restricted-application-user>
# MYSQL_PASSWORD=<secret-from-App-Service-or-Key-Vault>
# MYSQL_SSL=true
# MYSQL_SSL_CA= (Node roots), or /absolute/path/to/verified-root-bundle.pem
# TRUST_PROXY_HOPS=1 only for direct App Service ingress with no extra proxy.
# SCM_DO_BUILD_DURING_DEPLOYMENT=true (Azure deployment setting, not app code).
